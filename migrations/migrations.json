{
  "formatVersion": 2,
  "migrations": [
    {
      "version": "v0.2.0",
      "changes": [
        {
          "description": "Add concurrency control to sync workflow",
          "target": "sync",
          "fields": ["concurrency"]
        },
        {
          "description": "Filter bot-triggered events in review workflow",
          "target": "review",
          "fields": ["jobIf"]
        },
        {
          "description": "Remove deprecated ai-provider parameter",
          "target": "sync",
          "fields": ["stepParams.ai-provider"]
        }
      ],
      "sync": {
        "concurrency": {
          "group": "merge-mate-sync-${{ github.ref }}",
          "cancel-in-progress": true
        },
        "stepParams": {
          "ai-provider": null
        }
      },
      "review": {
        "jobIf": "github.event_name == 'workflow_dispatch' || (github.event.issue.pull_request && github.event.sender.type != 'Bot')"
      }
    },
    {
      "version": "v0.3.0",
      "changes": [
        {
          "description": "Switch review trigger from edited to created comments",
          "target": "review",
          "fields": ["triggers.issue_comment"]
        },
        {
          "description": "Add trigger-mode parameter for diff viewer integration",
          "target": "review",
          "fields": ["inputs.trigger-mode", "stepParams.trigger-mode"]
        },
        {
          "description": "Add issues:write permission for review workflow",
          "target": "review",
          "fields": ["permissions.issues"]
        },
        {
          "description": "Update secret reference to MERGE_MATE_API_KEY",
          "target": "sync",
          "fields": ["stepParams.ai-api-key"]
        }
      ],
      "sync": {
        "stepParams": {
          "ai-api-key": "${{ secrets.MERGE_MATE_API_KEY }}"
        }
      },
      "review": {
        "triggers": {
          "issue_comment": {
            "types": ["created"]
          }
        },
        "permissions": {
          "issues": "write"
        },
        "inputs": {
          "trigger-mode": {
            "description": "Trigger source",
            "required": false,
            "default": "workflow_dispatch",
            "type": "string"
          }
        },
        "stepParams": {
          "pr-number": "${{ github.event.issue.number || inputs.pr-number }}",
          "trigger-mode": "${{ inputs.trigger-mode }}"
        }
      }
    },
    {
      "version": "v0.4.0",
      "changes": [
        {
          "description": "Add typed repository_dispatch events for review workflow",
          "target": "review",
          "fields": ["triggers.repository_dispatch", "jobIf"]
        },
        {
          "description": "Remove unused trigger-mode input and parameter",
          "target": "review",
          "fields": ["inputs.trigger-mode", "stepParams.trigger-mode"]
        },
        {
          "description": "Update pr-number to include dispatch client_payload source",
          "target": "review",
          "fields": ["stepParams.pr-number"]
        },
        {
          "description": "Add concurrency control to review workflow",
          "target": "review",
          "fields": ["concurrency"]
        }
      ],
      "review": {
        "triggers": {
          "repository_dispatch": {
            "types": ["merge-mate-apply", "merge-mate-undo"]
          }
        },
        "concurrency": {
          "group": "merge-mate-review-${{ github.event.issue.number || github.event.client_payload.pr-number || inputs.pr-number }}",
          "cancel-in-progress": false
        },
        "inputs": {
          "trigger-mode": null
        },
        "stepParams": {
          "trigger-mode": null,
          "pr-number": "${{ github.event.issue.number || github.event.client_payload.pr-number || inputs.pr-number }}"
        },
        "jobIf": "github.event_name == 'workflow_dispatch' || github.event_name == 'repository_dispatch' || (github.event.issue.pull_request && github.event.sender.type != 'Bot')"
      }
    }
  ]
}

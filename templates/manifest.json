        },
        "concurrency": {
          "description": "Maximum number of PRs to process in parallel",
          "type": "number",
          "default": 3,
          "min": 1
        },
        "exclude-files": {
          "description": "Newline-separated glob patterns for files to exclude from AI resolution",
          "type": "text"
        }
      }
    },
    {
      "id": "sync-push-cron",

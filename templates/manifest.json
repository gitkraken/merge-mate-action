    },
    {
      "id": "review",
      "name": "Review",
      "description": "Apply or undo AI-resolved changes via PR comment buttons",
      "file": "review.yml",
      "category": "review",
      "default": true,
      "triggers": ["issue_comment", "repository_dispatch"],
      "placeholders": {

      "description": "Apply or undo AI-resolved changes via PR comment buttons or manual trigger from Actions tab",
      "file": "review-manual.yml",
      "category": "review",
      "triggers": ["issue_comment", "repository_dispatch", "workflow_dispatch"],
      "placeholders": {
        "VERSION": {
          "description": "Action version tag",

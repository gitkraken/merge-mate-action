{
  "formatVersion": 1,
  "templates": [
    {
      "id": "sync-push",
      "name": "Sync on Push",
      "description": "Syncs PRs when the target branch is updated",
      "file": "sync-push.yml",
      "category": "sync",
      "default": true,
      "triggers": ["push"],
      "placeholders": {
        "VERSION": {
          "description": "Action version tag",
          "default": "v0.4",
          "hidden": true
        },
        "DEFAULT_BRANCH": {
          "description": "Target branch name",
          "default": "main",
          "hidden": true
        }
      },
      "options": {
        "apply-policy": {
          "description": "How resolved conflicts are handled",
          "type": "choice",
          "values": ["auto", "resolved-only", "review", "dry-run"],
          "default": "auto"
        },
        "mode": {
          "description": "Sync strategy (rebase or merge)",
          "type": "choice",
          "values": ["rebase", "merge"],
          "default": "rebase"
        },
        "confidence-threshold": {
          "description": "Minimum AI confidence to auto-apply (%)",
          "type": "number",
          "default": 100,
          "min": 0,
          "max": 100
        },
        "log-level": {
          "description": "Log verbosity level",
          "type": "choice",
          "values": ["error", "warn", "info", "debug"],
          "default": "info"
        },
        "pr-filter": {
          "description": "YAML filter for selecting PRs (target-branches, labels, authors, created, include-drafts)",
          "type": "text"
        },
        "concurrency": {
          "description": "Maximum number of PRs to process in parallel",
          "type": "number",
          "default": 3,
          "min": 1
        },
        "exclude-files": {
          "description": "Newline-separated glob patterns for files to exclude from AI resolution",
          "type": "text"
        }
      }
    },
    {
      "id": "sync-cron",
      "name": "Sync on Schedule",
      "description": "Syncs PRs on a cron schedule and on push to the target branch",
      "file": "sync-cron.yml",
      "category": "sync",
      "triggers": ["schedule", "push"],
      "placeholders": {
        "VERSION": {
          "description": "Action version tag",
          "default": "v0.4",
          "hidden": true
        },
        "DEFAULT_BRANCH": {
          "description": "Target branch name",
          "default": "main",
          "hidden": true
        },
        "CRON_SCHEDULE": {
          "description": "Cron expression for scheduled sync runs",
          "default": "0 */6 * * *"
        }
      },
      "options": {
        "apply-policy": {
          "description": "How resolved conflicts are handled",
          "type": "choice",
          "values": ["auto", "resolved-only", "review", "dry-run"],
          "default": "auto"
        },
        "mode": {
          "description": "Sync strategy (rebase or merge)",
          "type": "choice",
          "values": ["rebase", "merge"],
          "default": "rebase"
        },
        "confidence-threshold": {
          "description": "Minimum AI confidence to auto-apply (%)",
          "type": "number",
          "default": 100,
          "min": 0,
          "max": 100
        },
        "log-level": {
          "description": "Log verbosity level",
          "type": "choice",
          "values": ["error", "warn", "info", "debug"],
          "default": "info"
        },
        "pr-filter": {
          "description": "YAML filter for selecting PRs (target-branches, labels, authors, created, include-drafts)",
          "type": "text"
        },
        "concurrency": {
          "description": "Maximum number of PRs to process in parallel",
          "type": "number",
          "default": 3,
          "min": 1
        },
        "exclude-files": {
          "description": "Newline-separated glob patterns for files to exclude from AI resolution",
          "type": "text"
        }
      }
    },
    {
      "id": "sync-manual",
      "name": "Sync Manual",
      "description": "On-demand sync from the Actions tab with mode and policy selection",
      "file": "sync-manual.yml",
      "category": "sync",
      "triggers": ["workflow_dispatch"],
      "placeholders": {
        "VERSION": {
          "description": "Action version tag",
          "default": "v0.4",

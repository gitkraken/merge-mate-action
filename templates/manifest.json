        },
        "confidence-threshold": {
          "description": "Minimum AI confidence to auto-apply (%)",
          "type": "number",
          "default": 100,
          "min": 0,
          "max": 100
        },
        "log-level": {
          "description": "Log verbosity level",
          "type": "choice",
          "values": ["error", "warn", "info", "debug"],
          "default": "info"
        },
        "pr-filter": {
          "description": "YAML filter for selecting PRs (target-branches, labels, authors, created, include-drafts)",
          "type": "text"
        },
        "concurrency": {
          "description": "Maximum number of PRs to process in parallel",
          "type": "number",
          "default": 3,
          "min": 1
        },
        "exclude-files": {
          "description": "Newline-separated glob patterns for files to exclude from AI resolution",
          "type": "text"

        "confidence-threshold": {
          "description": "Minimum AI confidence to auto-apply (%)",
          "type": "number",
          "default": 100,
          "min": 0,
          "max": 100
        },
        "log-level": {
          "description": "Log verbosity level",
          "type": "choice",
          "values": ["error", "warn", "info", "debug"],
          "default": "info"
        },
        "pr-filter": {
          "description": "YAML filter for selecting PRs (target-branches, labels, authors, created, include-drafts)",
